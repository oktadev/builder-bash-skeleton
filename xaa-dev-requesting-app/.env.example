# --- xaa.dev IdP (get CLIENT_ID/SECRET from https://xaa.dev/developer/register) ---
IDP_URL=https://idp.xaa.dev
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret

# --- Resource authorization server (issues access tokens via JWT-bearer of the ID-JAG) ---
# xaa.dev authenticates the JWT-bearer call with a distinct resource client
# (registration page issues this pair alongside the main IdP pair).
AUTH_SERVER_URL=https://auth.resource.xaa.dev
RESOURCE_CLIENT_ID=your-resource-client-id
RESOURCE_CLIENT_SECRET=your-resource-client-secret

# --- Normal-app mode target (REST API) ---
# Default points at the Todo0 playground resource; swap for a BYOR resource by
# changing URL/path/scopes to match whatever you registered in Wizard Step 1.
NORMAL_RESOURCE_URL=https://api.resource.xaa.dev
NORMAL_RESOURCE_PATH=/api/todos
NORMAL_SCOPES=todos.read

# --- MCP-client mode target (Todo0 MCP server) ---
MCP_SERVER_URL=https://mcp.xaa.dev
MCP_RESOURCE_URL=https://mcp.xaa.dev/mcp
MCP_SCOPES=todos.read,mcp.access

# --- App server ---
PORT=3000
REDIRECT_URI=http://localhost:3000/auth/callback
SESSION_SECRET=change-me-to-a-long-random-string
