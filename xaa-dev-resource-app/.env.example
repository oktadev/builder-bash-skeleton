# --- Server ---
PORT=4000
# Auth server runs on its own port (only when AUTH_MODE=own) so it can be
# exposed via a separate tunnel URL from the resource server.
AUTH_PORT=4001
# Public base URL of this resource app. Set this to the EXACT URL you entered
# in Wizard Step 1 at xaa.dev — trailing slash and all. The Auth Server does
# not normalize URLs, and whatever you registered is what lands in the `aud`
# claim. A mismatch here produces `invalid_token — unexpected "aud" claim value`.
RESOURCE_URL=http://localhost:4000

# --- Auth mode: "playground" or "own" ---
# playground: trust access tokens issued by https://auth.resource.xaa.dev
# own:        this app's own auth server (mounted at /auth) issues tokens after
#             accepting an ID-JAG from idp.xaa.dev via RFC 7523 jwt-bearer.
AUTH_MODE=playground

# --- Playground auth server (used when AUTH_MODE=playground) ---
PLAYGROUND_ISSUER=https://auth.resource.xaa.dev
PLAYGROUND_JWKS_URL=https://auth.resource.xaa.dev/jwks

# --- Own auth server (used when AUTH_MODE=own) ---
# Trusted IdP that signs ID-JAGs; we fetch its JWKS to verify the jwt-bearer assertion.
OWN_IDP_ISSUER=https://idp.xaa.dev
OWN_IDP_JWKS_URL=https://idp.xaa.dev/oauth2/v1/keys
# Expected audience inside the ID-JAG (this resource's own auth-server URL).
# When AUTH_MODE=own, the auth server runs on its own port (AUTH_PORT) mounted
# at root — no /auth path prefix needed.
OWN_AUTH_SERVER_URL=http://localhost:4001
# Access-token lifetime (seconds).
OWN_ACCESS_TOKEN_TTL=7200
# Path to RS256 private key (PKCS#8 PEM). Generate with: npm run keygen
OWN_PRIVATE_KEY_PATH=./keys/private.pem
OWN_PUBLIC_KEY_PATH=./keys/public.pem
OWN_KEY_ID=xaa-resource-1

# --- Scopes this resource recognises ---
SUPPORTED_SCOPES=files.read,files.write,folders.read,folders.write
