# XAA Hackathon Kit v3 — environment template
# Copy to .env.local and fill the per-developer block.
#   cp .env.example .env.local

# === Fixed (xaa.dev — leave as-is) ===
IDP_URL=https://idp.xaa.dev
AUTH_SERVER_URL=https://auth.resource.xaa.dev
RESOURCE_URL=https://api.resource.xaa.dev

# === Protocol path (new in v3) ===
# oidc = Authorization Code + PKCE login (default; pick this unless you need SAML)
# saml = SP-initiated SAML 2.0 Web Browser SSO, plus an extra Step 0b exchange
XAA_PROTOCOL=oidc

# === Per-developer (set from xaa.dev/developer/register) ===
# Pick the OIDC or SAML tab on the registration form to match XAA_PROTOCOL.

# OAuth client at the IdP — login (Step 0), SAML exchange (Step 0b), token-exchange (Step 1)
CLIENT_ID=
CLIENT_SECRET=

# OAuth client at the resource auth server — used for jwt-bearer (Step 2).
# xaa.dev derives this as {CLIENT_ID}-at-{resource_id}, e.g. client_abc-at-todo0.
# Don't strip the suffix.
RESOURCE_CLIENT_ID=
RESOURCE_CLIENT_SECRET=

# Resource target (defaults below are Todo0; override for BYOR)
RESOURCE_PATH=/api/todos
RESOURCE_SCOPES=todos.read

# Local app
APP_URL=http://localhost:3000

# --- OIDC path only (ignore when XAA_PROTOCOL=saml) ---
# Must be byte-exact with the redirect URI you registered.
REDIRECT_URI=http://localhost:3000/api/auth/callback

# --- SAML path only (ignore when XAA_PROTOCOL=oidc) ---
# Where the IdP POSTs the SAMLResponse. Byte-exact with what you registered.
SAML_ACS_URL=http://localhost:3000/api/auth/saml/acs
# emailAddress (recommended) or persistent. transient is UNSUPPORTED — your
# resource server keys users by NameID, so a per-session random value would
# create a new user on every login.
SAML_NAMEID_FORMAT=emailAddress
# TODO(confirm) SP entityID var name — the SAML registration form at
#   xaa.dev/developer/register?tab=saml is behind an email gate, so the name it
#   hands back is unverified. Register first, then add what you were given.
# TODO(confirm) whether xaa.dev issues an SP signing key. Its IdP metadata sets
#   WantAuthnRequestsSigned="false", so you shouldn't need one to send an
#   AuthnRequest — but assertion decryption would.

# Generate with: openssl rand -base64 32
# Windows (PowerShell): [Convert]::ToBase64String((1..32 | %{Get-Random -Min 0 -Max 256}))
SESSION_SECRET=

# NOTE: the refresh token is the session anchor and a long-lived credential.
# It belongs in your server-side session — never in this file, never in a log,
# never in the browser. xaa.dev has no revocation endpoint, so a leaked
# refresh token stays usable until it expires.
