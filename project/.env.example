# =============================================================================
# XAA Requesting App — environment variables
# =============================================================================
# Register at https://xaa.dev/developer/register to obtain TWO client pairs.
# The Cross-App Access (XAA / ID-JAG) flow uses two distinct OAuth clients:
#   1. CLIENT_ID/SECRET            — authenticates the OIDC login at the IdP
#   2. RESOURCE_CLIENT_ID/SECRET   — authenticates the JWT-bearer call at the
#                                    resource auth server
# Copy this file to `.env.local` and fill in the values.
# =============================================================================

# --- xaa.dev Identity Provider (issues ID Tokens, mints ID-JAGs) ---
IDP_URL=https://idp.xaa.dev
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret

# --- Resource authorization server (mints access tokens via jwt-bearer of ID-JAG) ---
AUTH_SERVER_URL=https://auth.resource.xaa.dev
RESOURCE_CLIENT_ID=your-resource-client-id
RESOURCE_CLIENT_SECRET=your-resource-client-secret

# --- Protected resource target (Todo0 default; override for BYOR) ---
RESOURCE_URL=https://api.resource.xaa.dev
RESOURCE_PATH=/api/todos
RESOURCE_SCOPES=todos.read

# --- App server / session ---
APP_URL=http://localhost:3000
REDIRECT_URI=http://localhost:3000/api/auth/callback

# 32+ char random secret used to encrypt the iron-session cookie.
# Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
